# Copy to backend/.env. DB_* must match the root .env used by docker-compose.
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=change_me_app
DB_NAME=vulntracker

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
